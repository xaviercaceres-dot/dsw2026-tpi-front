# Copiar como .env.development.local (o .env.local) solo si hace falta cambiar algún valor.
# .env.development ya trae estos mismos valores, así que alcanza con npm install y npm run dev.

# baseURL de Axios. Con "/" las llamadas van a /api/... en el mismo origen de Vite
# y el proxy del servidor de desarrollo las reenvía al backend (sin problemas de CORS).
VITE_BACKEND_URL=/

# URL del backend Dsw2026Tpi.Api (perfil "http" de launchSettings.json).
VITE_BACKEND_PROXY_TARGET=http://localhost:5278
